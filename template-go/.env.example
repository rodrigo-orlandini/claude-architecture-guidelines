PORT=8080
LOG_LEVEL=info

# Host for `npm`-less local runs: `go run ./cmd/api` (native) or via
# docker-compose.yml (app service). The compose file sets its own
# DATABASE_URL pointed at the container hostname; this one is for running
# the binary directly on the host, against the containerized Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{project_db}}_dev?sslmode=disable
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/{{project_db}}_test?sslmode=disable

# Empty = spans printed to stdout. With the observability stack:
# http://localhost:4318 (host) or http://host.docker.internal:4318 (container)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME={{project-slug}}
