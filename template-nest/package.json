{
  "name": "{{project-slug}}",
  "version": "1.0.0",
  "description": "{{PROJECT_DESCRIPTION}}",
  "private": true,
  "scripts": {
    "dev": "docker compose up",
    "dev:local": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:db:up": "node scripts/compose.mjs -f docker-compose.test.yml up -d --wait",
    "test:db:push": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5433/{{project_db}}_test prisma db push --schema prisma/schema.prisma --skip-generate --force-reset",
    "test:integration": "npm run test:db:up && npm run test:db:push && jest --config test/jest-e2e.json",
    "test:coverage": "npm run test:db:up && npm run test:db:push && jest --config jest.coverage.config.js --coverage",
    "test:all": "npm run test:unit && npm run test:integration",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.build.json",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^30.5.2",
    "prisma": "^5.22.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {}
}
