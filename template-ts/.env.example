NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Values for running on the host (npm run dev:local, prisma CLI). The `app` container in
# docker-compose.yml overrides DATABASE_URL and REDIS_URL with internal hostnames.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{project_db}}_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/{{project_db}}_test

REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6380

# Empty = spans on stdout. With the observability stack: http://localhost:4318 (host) or http://host.docker.internal:4318 (container)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME={{project-slug}}
