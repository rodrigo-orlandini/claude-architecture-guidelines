NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Valores para rodar no host (npm run dev:local, prisma CLI). O container `app` do
# docker-compose.yml sobrescreve DATABASE_URL e REDIS_URL com os hostnames internos.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{project_db}}_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/{{project_db}}_test

REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6380

# Vazio = spans no stdout. Com a stack de observabilidade: http://localhost:4318 (host) ou http://host.docker.internal:4318 (container)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME={{project-slug}}
