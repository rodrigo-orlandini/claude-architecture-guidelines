generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Convention: model in singular PascalCase, table in plural snake_case (@@map), columns in snake_case (@map).
// Domain enums: String column validated by the VO in the mapper (do not use Prisma enum — it couples the domain to the generated client).

// example module — delete along with src/modules/example.
model Item {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("items")
}
