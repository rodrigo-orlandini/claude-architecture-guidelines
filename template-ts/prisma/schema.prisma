generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Convenção: model PascalCase singular, tabela snake_case plural (@@map), colunas snake_case (@map).
// Enums de domínio: coluna String validada pelo VO no mapper (não use enum Prisma — acopla domínio ao client gerado).

// Módulo example — apagar junto com src/modules/example.
model Item {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("items")
}
