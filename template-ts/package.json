{
  "name": "{{project-slug}}",
  "version": "1.0.0",
  "description": "{{PROJECT_NAME}} — monolito modular com Clean Architecture",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/compose.mjs up",
    "infra:up": "node scripts/compose.mjs up -d postgres redis",
    "test:db:up": "node scripts/compose.mjs -f docker-compose.test.yml up -d --wait",
    "test:db:push": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5433/{{project_db}}_test prisma db push --skip-generate --force-reset",
    "dev:local": "tsx watch src/main.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "npm run test:db:up && npm run test:db:push && vitest run --config vitest.integration.ts",
    "test:coverage": "npm run test:db:up && npm run test:db:push && vitest run --config vitest.coverage.ts --coverage",
    "test:all": "npm run test:unit && npm run test:integration",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.22.0",
    "fastify": "^4.29.0",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "prisma": "^5.22.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
